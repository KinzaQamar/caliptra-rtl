name: "lowrisc:dv:csrng_sva:0.1"
description: "CSRNG assertion modules and bind file."
filesets:
  files_dv:
    files:
      - csrng_assert_if.sv
    file_type: systemVerilogSource

  files_formal:
    depend:
      - caliptra:compile_yml:csrng

targets:
  default: &default_target
    filesets:
      - files_dv
